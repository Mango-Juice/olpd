{
  "name": "one-line-per-death",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch server/dev.ts",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "eval:jev": "tsx --env-file=.env.local scripts/evaluate.ts",
    "preview": "vite preview --host 0.0.0.0",
    "test:browser": "npm run test:onboarding && npm run test:campaign:shared",
    "test:errors": "tsx scripts/browser-errors.ts",
    "test:notebook": "tsx scripts/browser-notebook.ts",
    "test:ui": "tsx scripts/browser-ui.ts",
    "test:priority": "tsx scripts/browser-priority.ts",
    "test:priority:live": "LIVE_AI=true tsx scripts/browser-priority.ts",
    "test:drag": "tsx scripts/browser-drag.ts",
    "test:guards": "tsx scripts/check-guards.ts",
    "eval:campaign": "tsx --env-file=.env.local scripts/evaluate-campaign-live.ts",
    "test:campaign:scenes": "tsx scripts/browser-campaign-scenes.ts",
    "test:onboarding": "tsx scripts/browser-chapter-one.ts",
    "test:campaign:shared": "tsx scripts/browser-shared-campaign.ts",
    "test:campaign:recovery": "tsx scripts/browser-campaign-recovery.ts",
    "eval:campaign:smoke": "tsx --env-file=.env.local scripts/evaluate-shared-live.ts",
    "test:canvas": "tsx scripts/browser-canvas-pause.ts",
    "generate:og": "tsx scripts/generate-social-image.ts",
    "check:seo": "tsx scripts/check-public-site.ts"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-kr": "^5.3.0",
    "@fontsource/gowun-batang": "^5.3.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": "22.x"
  }
}
