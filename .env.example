# Server-only key from https://app.typesafe.ai/
TYPESAFE_API_KEY=
# Server-only DeepSeek key for chapter 2+ campaign interpretation.
DEEPSEEK_API_KEY=
# disabled is the low-latency default; low is available for measured comparisons.
CAMPAIGN_DEEPSEEK_THINKING=disabled

# Set false to stop paid/provider calls immediately on the next server start/deploy.
AI_ENABLED=true
